root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml,scxml}]
indent_size = 2

[*.cs]
# File-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:error

# `var` only when the type is apparent from the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# expression styles.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_using_directive_placement = outside_namespace:suggestion

# Naming/ordering.
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Nullable-reference diagnostics are errors (TreatWarningsAsErrors covers these too).
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8618.severity = error

# Newlines.
csharp_new_line_before_open_brace = all
